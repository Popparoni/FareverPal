# --- Virtualenv (huge; recreate from requirements.txt) ---
.venv/
venv/
env/

# --- PyInstaller output ---
# The one-file exe is ~305 MB and ships as a GitHub RELEASE ASSET, never in git
# (GitHub rejects files >100 MB).
dist/
build/
*.spec
# ...but the committed FareverPal build spec IS tracked (single source of build
# truth).
!FareverPal.spec

# --- Rust build output (farever_native) ---
native/target/

# --- Python caches / bytecode ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# --- Logs ---
*.log

# --- Secrets / credentials (none expected, but never commit these) ---
.env
.env.*
*.pem
*.key
*.token
credentials*
secret*
id_rsa*

# --- Editor / OS cruft ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- local scratch / working files ---
_scratch*.py
_tmp*.py
*_dump.txt
*.txt.tmp
notes/
*PLAN.md
docs/*_INTERNALS.md

# --- local tooling / editor config ---
CLAUDE.md
**/CLAUDE.md
.claude/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
